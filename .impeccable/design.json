  "narrative": {
    "northStar": "Old-school charm. New-school shopping.",
    "overview": "A spacious modern shopping identity with painterly Indian fashion and a Renaissance twist. Clean Manrope headlines and cobalt controls keep the interface contemporary; the Instrument Serif wordmark and classical bust supply the historical quirk. Art belongs to the brand, while shopping results use explicitly labelled colour illustrations.",
    "keyCharacteristics": [
      "Pale canvas and cobalt actions.",
      "Oversized sans-serif headlines with a restrained serif brand voice.",
      "Painterly portrait fan and a shawled classical bust.",
      "Softly bordered panels, pill controls and honest sample labels."
    ],
    "rules": [
      {
        "name": "The Action Rule",
        "body": "Reserve solid cobalt fills for actions; keep everyday content panels pale or white. The memory story is a local exception: its indigo band and lighter profile panel form one deliberate contrast section, not a global dark theme.",
        "section": "colors"
      },
      {
        "name": "The Serif Rule",
        "body": "Keep serif type in brand accents; use Manrope for shopping controls and main headings.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the marketing website and shopping demo separate and linked.",
      "Do use painterly Indian fashion and classical art for brand imagery.",
      "Do preserve visible keyboard focus, labelled inputs and reduced-motion final poses.",
      "Do label fictional catalogue details and brand illustrations clearly."
    ],
    "donts": [
      "Don\u2019t present brand artwork as product photography.",
      "Don\u2019t imply real store connections, payments or purchases.",
      "Don\u2019t make motion necessary to read or operate the page."
    ]
  }
