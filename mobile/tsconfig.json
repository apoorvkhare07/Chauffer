{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "moduleSuffixes": ["", ".native", ".web"],
    "lib": ["ES2023", "DOM"],
    "types": ["node", "jest"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.tsx"
  ]
}
